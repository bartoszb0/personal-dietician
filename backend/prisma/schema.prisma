generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  profile          Profile?
  nutritionTargets NutritionTarget[]
  meals            Meal[]
  logEntries       DailyLogEntry[]
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sex                   Sex?
  birthDate             DateTime?      @db.Date
  heightCm              Int?
  weightKg              Decimal?       @db.Decimal(5, 2)
  activityLevel         ActivityLevel?
  goal                  Goal?
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NutritionTarget {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calories      Int
  proteinG      Int
  fatG          Int
  carbsG        Int
  isCustom      Boolean  @default(false)
  effectiveFrom DateTime @default(now())

  @@index([userId, effectiveFrom])
}

model Meal {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  calories Int
  proteinG Int
  fatG     Int
  carbsG   Int

  ingredients String?
  recipe      String?

  logEntries DailyLogEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DailyLogEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // the day it counts toward (local calendar date, sent by the client)
  date DateTime @db.Date

  // provenance — which meal it came from. SetNull so deleting a meal keeps the
  // entry (its macros are snapshotted below, so history is preserved).
  mealId String?
  meal   Meal?   @relation(fields: [mealId], references: [id], onDelete: SetNull)

  servings Decimal @db.Decimal(5, 2) @default(1)

  // snapshot copied at log time (meal macros × servings) — the source of truth
  // for daily totals, so editing/deleting a meal never rewrites past days.
  calories Int
  proteinG Int
  fatG     Int
  carbsG   Int

  createdAt DateTime @default(now())

  @@index([userId, date])
}